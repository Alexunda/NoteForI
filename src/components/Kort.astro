---
import Ikon from './Ikon.astro';
import type { IkonNavn } from '../data/ikoner';
import { url } from '../lib/sti';

interface Props {
  sti: string;
  ikon: IkonNavn;
  titel: string;
  tekst: string;
}

const { sti, ikon, titel, tekst } = Astro.props;
---

<a class="kort" href={url(sti)}>
  <span class="kort-ikon"><Ikon navn={ikon} /></span>
  <span class="kort-tekst">
    <span class="kort-titel">{titel}</span>
    <span class="kort-beskrivelse">{tekst}</span>
  </span>
</a>

<style>
  .kort {
    display: flex;
    align-items: center;
    gap: var(--afstand-4);
    height: 100%;
    min-height: 5.5rem;
    padding: var(--afstand-4);
    border: 1px solid var(--farve-kant);
    border-radius: var(--radius-l);
    background: var(--farve-flade);
    box-shadow: var(--skygge);
    color: var(--farve-tekst);
    text-decoration: none;
  }

  .kort:hover {
    border-color: var(--farve-accent);
  }

  .kort-ikon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-m);
    background: var(--farve-accent-svag);
    color: var(--farve-accent);
  }

  .kort-tekst {
    display: flex;
    flex-direction: column;
    gap: var(--afstand-1);
  }

  .kort-titel {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .kort-beskrivelse {
    color: var(--farve-tekst-svag);
    line-height: 1.4;
  }

  @media (min-width: 40rem) {
    .kort {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--afstand-5);
    }
  }
</style>
